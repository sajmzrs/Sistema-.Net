@model IEnumerable<AP.Data.Product>

@{
    ViewBag.Title = "Productos";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var currentCriteria = (ViewBag.Criteria as string) ?? string.Empty;
    var currentField = (ViewBag.Field as string) ?? string.Empty;
    var fieldOptions = new List<SelectListItem>
    {
        new SelectListItem { Text = "Nombre del producto", Value = "ProductName" },
        new SelectListItem { Text = "Descripción", Value = "Description" },
        new SelectListItem { Text = "Modificado por", Value = "ModifiedBy" },
        new SelectListItem { Text = "Valoración", Value = "Rating" }
    };
}

<main>
	<div class="page-header">
		<h1 class="mb-1">Productos</h1>
		<p class="lead text-muted mb-0">Administración del catálogo de productos</p>
	</div>

	<button onclick="showAlert('hola Daniel llegaste tarde hoy!!!')">Show Alert</button>
	<!-- "http://localhost:63499/Products/Index" -->
	<button onclick="callEndpoint('http://localhost:63499/Products/Index')">Make a call</button>
	<button onclick="callEndpoint('http://localhost:63499/Products/JsonCall')">Make a Json call</button>

	<div class="search-create-row">
		<div class="search-bar search-bar-inline mb-0">
			@using (Html.BeginForm("Search", "Products", FormMethod.Post, new { @class = "d-flex flex-wrap align-items-end gap-2" }))
			{
				<div>
					<label for="criteria">Buscar:</label>
					@Html.TextBox("criteria", currentCriteria, new { @class = "form-control", id = "criteria", placeholder = "Texto a buscar" })
				</div>
				<div>
					<label for="field">Campo:</label>
					@Html.DropDownList(
						"field",
						new SelectList(fieldOptions, "Value", "Text", currentField),
						"Seleccionar campo",
						new { @class = "form-select", id = "field" }
					)
				</div>
				<button type="submit" class="btn btn-primary">Buscar</button>
				@Html.ActionLink("Limpiar", "Index", "Products", null, new { @class = "btn btn-outline-secondary" })
			}
		</div>
		<div class="create-btn-wrap">
			<button type="button" class="btn btn-outline-primary" onclick="topRated()">Top Rated</button>
			@Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })
		</div>
	</div>

	<div class="table-wrapper">
		<table class="table table-dark table-striped table-hover">
			<thead>
				<tr>
					<th>@Html.DisplayNameFor(model => model.ProductName)</th>
					<th>@Html.DisplayNameFor(model => model.InventoryID)</th>
					<th>@Html.DisplayNameFor(model => model.SupplierID)</th>
					<th>@Html.DisplayNameFor(model => model.Description)</th>
					<th>@Html.DisplayNameFor(model => model.Rating)</th>
					<th>@Html.DisplayNameFor(model => model.CategoryID)</th>
					<th>@Html.DisplayNameFor(model => model.LastModified)</th>
					<th>@Html.DisplayNameFor(model => model.ModifiedBy)</th>
					<th>@Html.DisplayNameFor(model => model.CreatedBy)</th>
					<th class="text-end">Acciones</th>
				</tr>
			</thead>
			<tbody id="products-table-body">
				@foreach (var item in Model)
				{
					<tr>
						<td>@Html.DisplayFor(modelItem => item.ProductName)</td>
						<td>@Html.DisplayFor(modelItem => item.InventoryID)</td>
						<td>@Html.DisplayFor(modelItem => item.SupplierID)</td>
						<td>@Html.DisplayFor(modelItem => item.Description)</td>
						<td>@Html.DisplayFor(modelItem => item.Rating)</td>
						<td>@Html.DisplayFor(modelItem => item.CategoryID)</td>
						<td>@Html.DisplayFor(modelItem => item.LastModified)</td>
						<td>@Html.DisplayFor(modelItem => item.ModifiedBy)</td>
						<td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
						<td class="text-end action-links">
							<a href="@Url.Action("Edit", "Products", new { id = item.ProductID })"
							   class="action-icon-btn action-edit"
							   data-bs-toggle="tooltip"
							   data-bs-placement="top"
							   title="Editar"
							   aria-label="Editar">
								<span aria-hidden="true">✎</span>
							</a>
							<a href="#"
							   class="action-icon-btn action-details js-product-details"
							   data-details-url="@Url.Action("DetailsModal", "Products", new { id = item.ProductID })"
							   data-bs-toggle="tooltip"
							   data-bs-placement="top"
							   title="Detalles"
							   aria-label="Detalles">
								<span aria-hidden="true">👁</span>
							</a>
							<a href="@Url.Action("Delete", "Products", new { id = item.ProductID })"
							   class="action-icon-btn action-delete"
							   data-bs-toggle="tooltip"
							   data-bs-placement="top"
							   title="Eliminar"
							   aria-label="Eliminar">
								<span aria-hidden="true">🗑</span>
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="pagination-toolbar" id="products-pagination-toolbar">
		<span class="pagination-summary">Mostrando @Model.Count() de @totalItems productos</span>
		@if (totalPages > 1)
		{
			<nav aria-label="Paginación de productos">
				<ul class="pagination mb-0">
					<li class="page-item @(currentPage <= 1 ? "disabled" : "")">
						<a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, pageSize = 10, criteria = currentCriteria, field = currentField })">Anterior</a>
					</li>

					@for (int i = 1; i <= totalPages; i++)
					{
						<li class="page-item @(i == currentPage ? "active" : "")">
							<a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = 10, criteria = currentCriteria, field = currentField })">@i</a>
						</li>
					}

					<li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
						<a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, pageSize = 10, criteria = currentCriteria, field = currentField })">Siguiente</a>
					</li>
				</ul>
			</nav>
		}
	</div>

	<div class="modal fade product-details-modal" id="productDetailsModal" tabindex="-1" aria-labelledby="productDetailsModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="productDetailsModalLabel">Detalles del producto</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>
				<div class="modal-body" id="productDetailsBody">
					<div class="modal-loading">Cargando detalles...</div>
				</div>
			</div>
		</div>
	</div>
</main>

@section Scripts {
    <script>
        (function () {
            var filterUrl = '@Url.Action("Filter", "Products")';
            var editUrlTemplate = '@Url.Action("Edit", "Products", new { id = "__id__" })';
            var detailsUrlTemplate = '@Url.Action("DetailsModal", "Products", new { id = "__id__" })';
            var deleteUrlTemplate = '@Url.Action("Delete", "Products", new { id = "__id__" })';

            var detailsModalEl = document.getElementById('productDetailsModal');
            var detailsBody = document.getElementById('productDetailsBody');
            var productsTableBody = $('#products-table-body');
            var paginationToolbar = $('#products-pagination-toolbar');

            function buildUrl(template, id) {
                return template.replace('__id__', encodeURIComponent(id));
            }

            function renderError() {
                detailsBody.innerHTML = '<div class="modal-loading">No fue posible cargar los detalles.</div>';
            }

            function formatDate(value) {
                if (!value) return '';

                var match = /\/Date\((-?\d+)\)\//.exec(value);
                var date = match ? new Date(parseInt(match[1], 10)) : new Date(value);

                if (isNaN(date.getTime())) return '';
                return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
            }

            function addCell(row, value) {
                $('<td>').text(value == null ? '' : value).appendTo(row);
            }

            function initTooltips(scope) {
                if (!window.bootstrap || !window.bootstrap.Tooltip) return;

                $(scope).find('[data-bs-toggle="tooltip"]').each(function () {
                    bootstrap.Tooltip.getOrCreateInstance(this);
                });
            }

            function renderEmpty(message) {
                var row = $('<tr>');
                $('<td>').attr('colspan', 10).addClass('text-center').text(message).appendTo(row);
                productsTableBody.empty().append(row);
            }

            function renderProducts(products) {
                productsTableBody.empty();

                if (!products || products.length === 0) {
                    renderEmpty('No hay productos para mostrar.');
                    return;
                }

                $.each(products, function (_, product) {
                    var row = $('<tr>');
                    addCell(row, product.ProductName);
                    addCell(row, product.InventoryID);
                    addCell(row, product.SupplierID);
                    addCell(row, product.Description);
                    addCell(row, product.Rating);
                    addCell(row, product.CategoryID);
                    addCell(row, formatDate(product.LastModified));
                    addCell(row, product.ModifiedBy);
                    addCell(row, product.CreatedBy);

                    var actions = $('<td>').addClass('text-end action-links');

                    $('<a>')
                        .attr({
                            href: buildUrl(editUrlTemplate, product.ProductID),
                            title: 'Editar',
                            'aria-label': 'Editar',
                            'data-bs-toggle': 'tooltip',
                            'data-bs-placement': 'top'
                        })
                        .addClass('action-icon-btn action-edit')
                        .append($('<span>').attr('aria-hidden', 'true').text('E'))
                        .appendTo(actions);

                    $('<a>')
                        .attr({
                            href: '#',
                            title: 'Detalles',
                            'aria-label': 'Detalles',
                            'data-details-url': buildUrl(detailsUrlTemplate, product.ProductID),
                            'data-bs-toggle': 'tooltip',
                            'data-bs-placement': 'top'
                        })
                        .addClass('action-icon-btn action-details js-product-details')
                        .append($('<span>').attr('aria-hidden', 'true').text('D'))
                        .appendTo(actions);

                    $('<a>')
                        .attr({
                            href: buildUrl(deleteUrlTemplate, product.ProductID),
                            title: 'Eliminar',
                            'aria-label': 'Eliminar',
                            'data-bs-toggle': 'tooltip',
                            'data-bs-placement': 'top'
                        })
                        .addClass('action-icon-btn action-delete')
                        .append($('<span>').attr('aria-hidden', 'true').text('X'))
                        .appendTo(actions);

                    row.append(actions);
                    productsTableBody.append(row);
                });

                initTooltips(productsTableBody);
            }

            window.topRated = function () {
                if (!productsTableBody.length) return;

                renderEmpty('Cargando productos mejor valorados...');

                fetch(filterUrl + '?criteria=rating', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Error en la peticion');
                        return response.json();
                    })
                    .then(function (products) {
                        renderProducts(products);
                        paginationToolbar.html('<span class="pagination-summary">Mostrando ' + products.length + ' productos mejor valorados</span>');
                    })
                    .catch(function (error) {
                        console.error(error);
                        renderEmpty('Error al cargar los productos mejor valorados.');
                    });
            };

            if (!detailsModalEl || !detailsBody || !window.bootstrap) return;

            var detailsModal = new bootstrap.Modal(detailsModalEl);

            document.addEventListener('click', function (e) {
                var link = e.target.closest('.js-product-details');
                if (!link) return;

                e.preventDefault();
                var url = link.getAttribute('data-details-url');
                if (!url) return;

                detailsBody.innerHTML = '<div class="modal-loading">Cargando detalles...</div>';
                detailsModal.show();

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Failed request');
                        return response.text();
                    })
                    .then(function (html) {
                        detailsBody.innerHTML = html;
                    })
                    .catch(function () {
                        renderError();
                    });
            });
        })();
    </script>
}
