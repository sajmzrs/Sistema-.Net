@model IEnumerable<AP.Data.Notification>

@{
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var currentCriteria = (ViewBag.Criteria as string) ?? string.Empty;
    var currentField = (ViewBag.Field as string) ?? string.Empty;
    var currentFilter = (ViewBag.Filter as string) ?? string.Empty;
}

<div class="table-wrapper">
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Mensaje</th>
                <th>Leído</th>
                <th>Fecha de creación</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.id)</td>
                    <td>@Html.DisplayFor(modelItem => item.user_id)</td>
                    <td>@Html.DisplayFor(modelItem => item.message)</td>
                    <td>@Html.DisplayFor(modelItem => item.is_read)</td>
                    <td>@Html.DisplayFor(modelItem => item.created_at)</td>
                    <td class="text-end action-links">
                        <a href="@Url.Action("Edit", "Notifications", new { id = item.id })"
                           class="action-icon-btn action-edit"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Editar"
                           aria-label="Editar">
                            <span aria-hidden="true">✎</span>
                        </a>
                        <a href="#"
                           class="action-icon-btn action-details js-notification-details"
                           data-details-url="@Url.Action("DetailsModal", "Notifications", new { id = item.id })"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Detalles"
                           aria-label="Detalles">
                            <span aria-hidden="true">👁</span>
                        </a>
                        <a href="@Url.Action("Delete", "Notifications", new { id = item.id })"
                           class="action-icon-btn action-delete"
                           data-bs-toggle="tooltip"
                           data-bs-placement="top"
                           title="Eliminar"
                           aria-label="Eliminar">
                            <span aria-hidden="true">🗑</span>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pagination-toolbar">
    <span class="pagination-summary">Mostrando @Model.Count() de @totalItems notificaciones</span>
    @if (totalPages > 1)
    {
        <nav aria-label="Paginación de notificaciones">
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link js-ajax-link" href="@Url.Action("Index", new { page = currentPage - 1, pageSize = 10, criteria = currentCriteria, field = currentField, filter = currentFilter })">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link js-ajax-link" href="@Url.Action("Index", new { page = i, pageSize = 10, criteria = currentCriteria, field = currentField, filter = currentFilter })">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link js-ajax-link" href="@Url.Action("Index", new { page = currentPage + 1, pageSize = 10, criteria = currentCriteria, field = currentField, filter = currentFilter })">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
