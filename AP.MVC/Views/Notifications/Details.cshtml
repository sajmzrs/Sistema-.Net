@model AP.Data.Notification

@{
    ViewBag.Title = "Detalles de la notificación";
}

<main>
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1 class="mb-1">Detalles de la notificación</h1>
            <p class="lead text-muted mb-0">Notificación #@Model.id</p>
        </div>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
        </div>
    </div>

    <div class="detail-card">
        <dl class="dl-horizontal">
            <dt>ID</dt>
            <dd>@Html.DisplayFor(model => model.id)</dd>

            <dt>ID de usuario</dt>
            <dd>@Html.DisplayFor(model => model.user_id)</dd>

            <dt>Mensaje</dt>
            <dd>@Html.DisplayFor(model => model.message)</dd>

            <dt>Leído</dt>
            <dd>@Html.DisplayFor(model => model.is_read)</dd>

            <dt>Fecha de creación</dt>
            <dd>@Html.DisplayFor(model => model.created_at)</dd>
        </dl>
    </div>
</main>
